# --- Obligatorias ---
# Token del bot de Telegram y chat/canal donde recibir las alertas.
# Si las dos quedan vacías, el bot corre en dry-run (imprime por consola).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URLs de búsqueda de Zonaprop (una por línea o separadas por coma).
# Ej: https://www.zonaprop.com.ar/departamentos-compra-san-isidro-vicente-lopez.html
SEARCH_URLS=

# --- Opcionales (si no están definidas, no se usan) ---
# FlareSolverr para resolver el challenge de Cloudflare con navegador real.
# Si falta, el bot intenta con huella TLS de Chrome directo.
FLARESOLVERR_URL=

# Proxy HTTP rotativo (p.ej. http://192.168.1.150:8089). Si falta, conexión directa.
HTTP_PROXY=

# --- Ajustes ---
CHECK_INTERVAL=60m
FETCH_RETRIES=3
FETCH_TIMEOUT=30s
MAX_BROWSER_TIMEOUT=60s
DATA_DIR=/data