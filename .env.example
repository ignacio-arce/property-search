# --- Telegram ---
# Token del bot. Si queda vacio, el bot corre en dry-run (imprime por consola).
TELEGRAM_BOT_TOKEN=
# Destino de las alertas en dev/dry-run.
TELEGRAM_CHAT_ID=

# --- Zonaprop fetch ---
# FlareSolverr es OBLIGATORIO en modo servidor: Zonaprop responde 403 con
# `cf-mitigated: challenge` y ningun cliente HTTP pasa eso sin un browser real.
# En compose se resuelve por nombre de servicio (http://flaresolverr:8191);
# para correr el binario local, apuntar al host donde este FlareSolverr.
FLARESOLVERR_URL=

# Proxy rotativo SOLO para el trafico a Zonaprop (dev: http://192.168.1.150:8089).
# NO se llama HTTP_PROXY a proposito: Go lee HTTP_PROXY del entorno por defecto y
# enrutaria tambien Telegram, FlareSolverr y las fotos por el proxy rotativo.
ZONAPROP_PROXY=

# Proxy con el que SALE FlareSolverr (Chromium). En su contenedor va como PROXY_URL.
# NUNCA como HTTP_PROXY/HTTPS_PROXY: Chromium los lee del entorno, su chequeo de
# arranque falla con "Error getting browser User-Agent" y el contenedor muere.
# Dev: http://192.168.1.150:8089
FLARESOLVERR_PROXY_URL=

# --- Postgres ---
POSTGRES_USER=zonaprop
POSTGRES_PASSWORD=
POSTGRES_DB=zonaprop
# Host/puerto los fija compose por nombre de servicio. Para correr el binario
# local contra un Postgres de la maquina, usar localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Seeds (opcional) ---
# Presiembra un usuario para ejercitar el pipeline antes de que exista /start.
# Formato: entradas separadas por coma, cada una "label|url", en UNA sola linea
# (multi-linea sin comillas rompe el parseo de env_file). El label no puede
# contener "|" ni ",".
# Ej: San Isidro 3amb|https://www.zonaprop.com.ar/departamentos-venta-...html
SEED_CHAT_ID=
SEED_URLS=

# --- Ajustes ---
# Deprecado: las URLs de busqueda ahora son por usuario en Postgres. Se mantiene
# solo para que el bot v1 siga funcionando hasta que se reescriba (V1.5/V7.3).
SEARCH_URLS=
FETCH_RETRIES=3
FETCH_TIMEOUT=30s
MAX_BROWSER_TIMEOUT=60s
# Espaciado minimo entre requests a Zonaprop. Es la defensa #1 contra Cloudflare:
# en las sondas escalo tras ~4 requests en 10 minutos.
FETCH_RATE_LIMIT=60s
# DATA_DIR no se define aca: la imagen ya trae /data y para correr local conviene
# el default del binario (./data). Se elimina en V7.3.
